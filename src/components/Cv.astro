---
import { getCv } from '../lib/content';
import { formatRange, inline } from '../lib/format';

interface Row {
  title: string;
  org: string;
  dates: string;
  bullets?: string[];
}

const toRows = (entries: Awaited<ReturnType<typeof getCv>>): Row[] =>
  entries.map(({ data }) => ({
    title: data.title,
    org: data.org,
    dates: formatRange(data.start, data.end),
    bullets: data.bullets,
  }));

const sections = [
  { title: 'Education', rows: toRows(await getCv('education')) },
  { title: 'Experience', rows: toRows(await getCv('experience')) },
  { title: 'Scholarships', rows: toRows(await getCv('scholarships')) },
].filter((s) => s.rows.length > 0);
---

<section id="cv" aria-labelledby="cv-title">
  <h2 id="cv-title" class="section-title">CV</h2>
  {sections.map((s) => (
    <div class="subsection">
      <h3 class="subsection-title">{s.title}</h3>
      <ul class="entries">
        {s.rows.map((r) => (
          <li class="entry">
            <h4 set:html={inline(r.title)} />
            <p class="org">{r.org}</p>
            <p class="dates">{r.dates}</p>
            {r.bullets && r.bullets.length > 0 && (
              <ul class="bullets">
                {r.bullets.map((b) => <li set:html={inline(b)} />)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.35rem;
  }

  /* Dates sit top-right beside the title; long titles wrap next to them. */
  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'title dates'
      'org   org'
      'list  list';
    align-items: baseline;
    column-gap: 1.5rem;
  }

  h4 {
    grid-area: title;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .dates {
    grid-area: dates;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .org {
    grid-area: org;
    color: var(--muted);
  }

  .bullets {
    grid-area: list;
    margin: 0.35rem 0 0;
    padding-left: 1.25rem;
    list-style: disc;
    font-size: 0.9688rem;
  }

  .bullets li::marker {
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .entry {
      column-gap: 0.75rem;
    }

    .dates {
      font-size: 0.875rem;
    }
  }
</style>
