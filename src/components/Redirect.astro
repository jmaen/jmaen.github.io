---
// Small static redirect page for old URLs (GitHub Pages has no server-side redirects).
interface Props {
  to: string;
}
const { to } = Astro.props;
const target = new URL(to, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body>
    <p>This page has moved to <a href={to}>{target.href}</a>.</p>
  </body>
</html>
