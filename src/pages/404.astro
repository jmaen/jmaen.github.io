---
import Base from '../layouts/Base.astro';

const nav = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  { id: 'cv', label: 'CV' },
];
---

<Base title="Page not found" nav={nav} noindex>
  <section class="not-found" aria-labelledby="nf-title">
    <p class="code">404</p>
    <h1 id="nf-title">This page doesn't exist.</h1>
    <p>It may have moved when the site was rebuilt. Everything now lives on one page.</p>
    <p><a href="/">Go to the home page →</a></p>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    gap: 0.75rem;
    padding-block: 5rem 6rem;
  }

  .code {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  h1 {
    font-size: 2.25rem;
  }
</style>
